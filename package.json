{
  "name": "supply-control-mcp-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manual MCP and JSON-RPC chatbot for food supply planning",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && vite build",
    "dev:web": "vite",
    "chatbot": "node --enable-source-maps dist/src/chatbot/cli.js",
    "mcp:supply": "node --enable-source-maps dist/src/mcp/supply-server-entry.js",
    "mcp:supply:http": "node --enable-source-maps dist/src/mcp/supply-server-http-entry.js",
    "demo": "node --enable-source-maps dist/src/demo/run-demo.js",
    "demo:filesystem": "node --enable-source-maps dist/src/demo/run-official-readonly-demo.js filesystem",
    "demo:git": "node --enable-source-maps dist/src/demo/run-official-readonly-demo.js git",
    "demo:remote": "node --enable-source-maps dist/src/demo/run-remote-demo.js",
    "capture:remote": "node --enable-source-maps --tls-keylog=tmp/tls-keys.log dist/src/demo/run-remote-demo.js",
    "demo:scenario": "node --enable-source-maps dist/src/demo/run-official-scenario.js",
    "test": "npm run build:server && node --test \"dist/test/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
