{
  "servers": {
    "supply": {
      "enabled": true,
      "command": "node",
      "args": ["dist/src/mcp/supply-server-entry.js"],
      "cwd": "${workspaceRoot}"
    },
    "filesystem": {
      "enabled": true,
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceRoot}"
      ],
      "cwd": "${workspaceRoot}"
    },
    "git": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-git",
        "--repository",
        "${workspaceRoot}"
      ],
      "cwd": "${workspaceRoot}"
    }
  }
}
