# Create a local .env file. Never commit real credentials.

# Required. Obtain a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5, the lowest-cost model that supports
# tool use. Use claude-sonnet-5 for stronger multi-step tool reasoning.
ANTHROPIC_MODEL=

MCP_CONFIG_PATH=config/mcp-servers.json
MCP_LOG_PATH=logs/mcp-interactions.jsonl
